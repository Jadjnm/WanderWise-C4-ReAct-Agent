# ==============================================================================
# WanderWise Agent Project - Environment Configuration
# ==============================================================================

# LLM Provider selection: 'gemini' | 'openrouter' | 'openai' | 'bedrock' | 'simulated' (C4 only)
# This choice is always honoured. Leave blank to auto-detect from the first real key below.
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini (via https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. OpenRouter (OpenAI-compatible; supports free models & budget models)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# ------------------------------------------------------------------------------
# 3. Standard OpenAI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. AWS Bedrock (Optional; used by C3 and C4)
# ------------------------------------------------------------------------------
# Use EITHER a Bedrock API key (Bedrock console > API keys) ...
AWS_BEARER_TOKEN_BEDROCK=
# ... OR an IAM access key pair ...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ... OR a named AWS profile from ~/.aws/credentials.
AWS_PROFILE=
AWS_REGION=us-east-1
# Use an inference-profile id (the "us." / "eu." / "apac." prefix must match AWS_REGION).
# The model must be enabled under Bedrock console > Model access.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional second Bedrock model for the "model type" comparison in the params suite
BEDROCK_ALT_MODEL=

# ------------------------------------------------------------------------------
# Agent Features
# ------------------------------------------------------------------------------
# Set to 1 to enable the reflection self-correction pass (logs to logs/reflections.jsonl)
ENABLE_REFLECTION=0

# ------------------------------------------------------------------------------
# C4 ReAct agent & experiments
# ------------------------------------------------------------------------------
# Set to 1 to force the labelled offline simulator (no API calls). Never use simulated
# runs as evidence in the reflection.
REACT_SIMULATE=0
# Optional second model for the "model type" comparison in `python experiments.py --suite params`
EXPERIMENT_ALT_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional comma-separated list of models for `python experiments.py --suite models` (can also pass --models)
EXPERIMENT_MODELS=